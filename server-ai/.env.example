# #############################################################
#  Variables de entorno del backend de Flex Intelligence
#  ------------------------------------------------------------
#  Copia este fichero, rellenalo y cargalo antes de arrancar:
#      cp .env.example .env && nano .env
#      set -a && . ./.env && set +a && npm start
#
#  NO SUBAS TU .env A NINGUN SITIO. Lleva el token, y con el token
#  cualquiera que llegue a tu servidor puede usarlo.
# #############################################################

# --- OBLIGATORIO ---
# Token que tiene que mandar el dispositivo. Minimo 16 caracteres; sin
# el, el servidor NO arranca -- mejor no arrancar que quedarse abierto a
# cualquiera. Genera uno con:  openssl rand -hex 24
# Para REVOCARLO: cambia este valor y reinicia. El dispositivo dira
# "Token rechazado" hasta que pongas el nuevo en Ajustes.
FLEXAI_TOKEN=

# --- TLS (obligatorio para que el dispositivo se conecte) ---
# El firmware EXIGE https y valida el certificado; no hay forma de
# saltarselo. Genera uno de pruebas con:
#     bash tools/make-cert.sh <IP-de-tu-PC>
FLEXAI_TLS_CERT=certs/server.crt
FLEXAI_TLS_KEY=certs/server.key

# --- Red ---
FLEXAI_PORT=8443
FLEXAI_HOST=0.0.0.0

# --- Proveedor ---
# local = sin red y sin claves (valor de fabrica). Hace transformaciones
#         deterministas y DICE lo que no puede hacer, en vez de fingirlo.
# http  = reenvia a un servicio real (rellena las FLEXAI_UPSTREAM_*).
FLEXAI_PROVIDER=local

# Solo con FLEXAI_PROVIDER=http. La clave se lee de aqui y no se escribe
# en disco ni se registra en ningun log.
#FLEXAI_UPSTREAM_URL=https://tu-proveedor.example/v1/responses
#FLEXAI_UPSTREAM_KEY=
#FLEXAI_UPSTREAM_MODEL=
#FLEXAI_UPSTREAM_TIMEOUT_MS=20000

# --- Limites ---
# Peticiones por minuto y por dispositivo. Un dispositivo real no pasa
# de unas pocas: las lanza una persona tocando un boton.
FLEXAI_RATE_MAX=30

# --- Solo para depurar el protocolo con curl ---
# Arranca SIN TLS. El dispositivo no se conectara asi (exige https).
#FLEXAI_ALLOW_PLAINTEXT=1

# ESP32-P4 rev v3.0 .. v3.99 (no arranca en v0.x ni v1.x).
# REV_MIN_300 acepta tambien v3.0; si la placa es v3.1 o posterior se puede
# subir a CONFIG_ESP32P4_REV_MIN_301=y (el valor por defecto de ESP-IDF).
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y

# ESP32-P4 rev v0.1 .. v1.99 (no arranca en v3.x ni en v0.0).
# REV_MIN_1 y no REV_MIN_0: con REV_MIN_0 desaparece la flash a 80 MHz.
# Si esptool dice v0.0, cambia esta linea por CONFIG_ESP32P4_REV_MIN_0=y.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

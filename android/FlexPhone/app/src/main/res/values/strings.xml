<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Flex Phone</string>
    <string name="back">Volver</string>
    <string name="stop">Detener</string>

    <string name="notif_listener_label">Notificaciones de Flex Phone</string>

    <!-- Canal e interfaz del servicio del enlace -->
    <string name="channel_link">Enlace con Flex OS</string>
    <string name="channel_link_desc">Notificacion permanente mientras el enlace esta activo. Se puede parar desde ella.</string>
    <string name="link_connected">Conectado a Flex OS</string>
    <string name="link_pairing">Emparejando: confirma el codigo</string>
    <string name="link_connecting">Conectando…</string>
    <string name="link_searching">Esperando a Flex OS…</string>
    <!-- El enlace es una conexion de la red local: sin Wi-Fi no hay a donde
         conectarse, y decir "Bluetooth no disponible" seria mentir sobre el
         motivo desde que el transporte es Wi-Fi. -->
    <string name="link_unavailable">Enlace no disponible</string>
    <string name="link_needs_wifi">Este telefono no esta en una red Wi-Fi</string>
    <!-- Android puede parar el servicio por bateria, memoria o politica del
         fabricante. Cuando pasa, se dice: un estado que sigue poniendo
         "escuchando" con el socket cerrado hace imposible entender por que
         el reloj no encuentra nada. -->
    <string name="link_stopped_by_system">Android detuvo el enlace. Vuelve a activarlo.</string>
    <string name="link_error">Error de enlace</string>
    <string name="link_off">Enlace desactivado</string>

    <!-- Canal e interfaz del Browser Relay -->
    <string name="channel_relay">Browser Relay</string>
    <string name="channel_relay_desc">Notificacion permanente mientras el telefono sirve el navegador a Flex OS.</string>
    <string name="relay_title">Browser Relay</string>
    <string name="relay_starting">Iniciando…</string>
    <!-- %1$s = IP, %2$d = puerto -->
    <string name="relay_waiting">Esperando a Flex OS en %1$s:%2$d</string>
    <string name="relay_active">Sirviendo el navegador a Flex OS</string>
    <string name="relay_client_gone">Flex OS se desconecto</string>
    <string name="relay_suspended">Android suspendio el relay (ahorro de bateria)</string>
    <string name="relay_battery_note">Mantiene la CPU y el Wi-Fi despiertos mientras dura la sesion.</string>
</resources>

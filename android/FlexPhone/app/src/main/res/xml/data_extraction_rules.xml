<?xml version="1.0" encoding="utf-8"?>
<!--
  NADA de esta app se incluye en copias de seguridad ni en
  transferencias a otro telefono.

  Es deliberado: los ajustes contienen la lista de aplicaciones que
  el usuario permitio y la referencia al dispositivo vinculado. Un
  respaldo en la nube de eso no aporta nada (el vinculo Bluetooth no
  se puede restaurar de todas formas) y si amplia la superficie de
  exposicion. Emparejar de nuevo cuesta menos de un minuto.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
